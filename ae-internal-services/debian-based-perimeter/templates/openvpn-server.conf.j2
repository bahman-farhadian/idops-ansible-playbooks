# {{ openvpn_profile.name }} pushes only the routes below.
local {{ firewall_ha_vip_wan }}
port {{ openvpn_profile.port }}
proto tcp-server
dev {{ openvpn_profile.device }}
dev-type tun
ca /etc/openvpn/server/ca.crt
cert /etc/openvpn/server/server.crt
key /etc/openvpn/server/server.key
server {{ openvpn_profile.network }} {{ openvpn_profile.netmask }}
topology subnet
# ECDH is negotiated. OpenVPN 2.6 exits at startup when this line is absent.
dh none
script-security 2
tls-verify "/etc/openvpn/server/tls-verify.sh /etc/openvpn/server/allowed-{{ openvpn_profile.name }}"
{% for route in openvpn_profile.routes %}
push "route {{ route.address }} {{ route.netmask }}"
{% endfor %}
keepalive 10 120
data-ciphers AES-256-GCM:AES-128-GCM
auth SHA256
user nobody
group nogroup
persist-key
persist-tun
remote-cert-tls client
verb 3
