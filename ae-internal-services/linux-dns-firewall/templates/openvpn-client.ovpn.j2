# {{ openvpn_profile.name }} profile. Routes are pushed by the server.
client
dev tun
proto udp
remote {{ firewall_ha_vip_wan }} {{ openvpn_profile.port }}
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
data-ciphers AES-256-GCM:AES-128-GCM
auth SHA256
verb 3
<ca>
{{ lookup('file', openvpn_pki_dir + '/ca.crt') }}
</ca>
<cert>
{{ lookup('file', openvpn_pki_dir + '/' + openvpn_profile.name + '.crt') }}
</cert>
<key>
{{ lookup('file', openvpn_pki_dir + '/' + openvpn_profile.name + '.key') }}
</key>
