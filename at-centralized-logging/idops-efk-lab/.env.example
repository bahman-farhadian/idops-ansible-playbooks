# Template for this lab's .env. Copy it, then run from the copy:
#   cp .env.example .env
# .env is gitignored — real local values (and any credential this lab ever
# grows) live there, never in this tracked file.
#
# Pinned image tags. Pins checked against upstream on 2026-10-21;
# re-verify before you run: https://www.elastic.co/guide/en/welcome-to-elastic/current/new.html
# and https://fluentbit.io/announcements/ . No secret lives in this template.
ELASTIC_VERSION=9.5.2
FLUENT_BIT_VERSION=5.0.8

# Kibana's encryptedSavedObjects key (required — without it, alerting/monitoring
# retries internally and floods the log; see 04-post-start-checklist.md).
# Generate once per .env, then leave it alone — rotating it orphans any saved
# alert/action objects already encrypted with the old value:
#   openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=

# Kibana's session-cookie key (xpack.security.encryptionKey). Without it,
# Kibana generates a random one every boot, which invalidates every open
# session — you'd have to log back in after every `docker compose restart
# kibana`. Generate once, leave it alone, same reasoning as the key above:
#   openssl rand -hex 32
KIBANA_SECURITY_ENCRYPTION_KEY=

# X-Pack security credentials — this is the lab's actual username/password
# login (see 02-run.md). Generate your own, once per .env:
#   openssl rand -hex 18
# ELASTIC_PASSWORD is the `elastic` superuser, used to log into Kibana.
# KIBANA_SYSTEM_PASSWORD is for the built-in `kibana_system` service account
# Kibana itself uses to talk to Elasticsearch (never log in with it).
# LOG_WRITER_PASSWORD is a least-privilege user (role: write-only on this
# lab's index) that Fluent Bit authenticates as.
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
LOG_WRITER_PASSWORD=

# IDOPS_PASSWORD is the password for a named superuser `idops`, created
# alongside `elastic` so you don't have to log in as the bootstrap account
# day to day. Generate it the same way as the passwords above:
#   openssl rand -hex 18
# (Elasticsearch's native realm hard-rejects anything under 6 characters,
# so this can't be a short literal like "idops" itself.)
IDOPS_PASSWORD=
