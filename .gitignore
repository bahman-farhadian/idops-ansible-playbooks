# macOS filesystem metadata
.DS_Store
**/.DS_Store

# Python virtual environment (single, project-level)
venv/
.venv/
ENV/
env/

# Python cache artifacts
__pycache__/
**/__pycache__/
*.pyc

# Ansible runtime artifacts
.ansible/
**/.ansible/
*.retry

# Local, machine-specific overrides (never committed)
*.local.yml
**/*.local.yml
*.local.yml.bak
**/*.local.yml.bak

# Local logs and secrets
*.log
vars/local-secrets.yml
**/vars/local-secrets.yml
group_vars/local_secrets.yml
**/group_vars/local_secrets.yml
.nexus_admin_password
.nexus_db_password
.nexus_secret_key
.nexus_secret_salt
.nexus_secret_iv

# Offline dependency cache (populated by `make deps-bundle`)
wheelhouse/

# Local runtime artifacts (Lynis scan reports, etc.)
ag-os-baseline-and-hardening/debian-os-hardening/artifacts/
