[Unit]
Description=IDOPs zram compressed swap
DefaultDependencies=no
After=local-fs.target systemd-sysctl.service
Before=swap.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/idops-zram-swap start
ExecStop=/usr/local/sbin/idops-zram-swap stop

[Install]
WantedBy=swap.target
