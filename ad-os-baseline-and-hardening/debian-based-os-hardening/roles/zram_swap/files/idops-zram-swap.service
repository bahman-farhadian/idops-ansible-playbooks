[Unit]
Description=IDOPs zram compressed swap
After=local-fs.target systemd-modules-load.service systemd-sysctl.service
Before=umount.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/idops-zram-swap start
ExecStop=/usr/local/sbin/idops-zram-swap stop

[Install]
WantedBy=multi-user.target
