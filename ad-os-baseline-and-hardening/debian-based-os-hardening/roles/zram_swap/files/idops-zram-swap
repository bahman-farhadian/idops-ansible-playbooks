#!/bin/sh
# Compressed RAM swap. Size is PERCENT of MemTotal.
# start after stop (systemctl restart) must succeed.
set -eu
DEFAULTS=/etc/default/idops-zram-swap
PERCENT=50
ALGO=zstd
PRIORITY=100
if [ -f "$DEFAULTS" ]; then
  # shellcheck disable=SC1090
  . "$DEFAULTS"
fi
DEV=/dev/zram0

load_module() {
  if [ -e /sys/block/zram0 ] || [ -d /sys/class/zram-control ]; then
    return 0
  fi
  modprobe zram 2>/dev/null || true
  if [ -e /sys/block/zram0 ] || [ -d /sys/class/zram-control ]; then
    return 0
  fi
  echo "idops-zram-swap: zram module missing (Ubuntu: linux-modules-extra-$(uname -r))" >&2
  return 1
}

add_zram0() {
  if [ -e /sys/block/zram0 ]; then
    return 0
  fi
  if [ -w /sys/class/zram-control/hot_add ]; then
    cat /sys/class/zram-control/hot_add >/dev/null
  else
    modprobe zram num_devices=1 2>/dev/null || true
  fi
  [ -e /sys/block/zram0 ]
}

drop_zram0() {
  if grep -q zram0 /proc/swaps 2>/dev/null; then
    swapoff "$DEV" || true
  fi
  if [ -e /sys/block/zram0/reset ]; then
    echo 1 > /sys/block/zram0/reset 2>/dev/null || true
  fi
  if [ -e /sys/block/zram0 ] && [ -w /sys/class/zram-control/hot_remove ]; then
    echo 0 > /sys/class/zram-control/hot_remove 2>/dev/null || true
  fi
}

configure_zram0() {
  echo "$ALGO" > /sys/block/zram0/comp_algorithm
  MEM_KB=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  echo $((MEM_KB * 1024 * PERCENT / 100)) > /sys/block/zram0/disksize
}

case "${1:-}" in
start)
  load_module
  drop_zram0
  add_zram0 || {
    echo "idops-zram-swap: cannot create zram0" >&2
    exit 1
  }
  if ! configure_zram0; then
    drop_zram0
    add_zram0
    configure_zram0
  fi
  mkswap "$DEV"
  swapon -p "$PRIORITY" "$DEV"
  ;;
stop)
  drop_zram0
  ;;
*)
  echo "usage: $0 start|stop" >&2
  exit 2
  ;;
esac
